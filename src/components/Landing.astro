---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languageTags, translate, type Locale } from '../i18n';
import Icon from './Icon.astro';
import weighing from '../assets/pesaje.png';
import sample from '../assets/muestra.png';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/landing.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translate(locale);
const alternate = locale === 'es' ? 'en' : 'es';
const localeUrls = { es: getRelativeLocaleUrl('es'), en: getRelativeLocaleUrl('en') };
const alternateUrl = localeUrls[alternate];
const assetRoot = import.meta.env.BASE_URL.replace(/\/$/, '');
const shareImage = Astro.site && new URL(`${assetRoot}/marca/originlink-social.jpg`, Astro.site);
const shareUrl = Astro.site && new URL(localeUrls[locale], Astro.site);
const shareLocales = { es: 'es_PE', en: 'en_US' } satisfies Record<Locale, string>;
const externalEndpoint = import.meta.env.PUBLIC_PILOT_ENDPOINT?.trim();
const pilotEndpoint = externalEndpoint || '/api/piloto';
const appUrl = 'https://originlink.web.app/';
const steps = [
  { icon: 'inventory', title: 'stepOne', body: 'stepOneBody' },
  { icon: 'forecast', title: 'stepTwo', body: 'stepTwoBody' },
  { icon: 'network', title: 'stepThree', body: 'stepThreeBody' }
] as const;
const links = [
  { href: '#ejemplo', label: 'exampleLink' },
  { href: '#proceso', label: 'processLabel' },
  { href: '#proveedores', label: 'supplierLink' }
] as const;
---
<!doctype html>
<html lang={languageTags[locale]} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173c2e" />
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/svg+xml" href={assetRoot + "/marca/03-isotipo.svg"} />
    <title>{t.title}</title>
    {shareUrl && shareImage && <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="OriginLink" />
      <meta property="og:title" content={t.title} />
      <meta property="og:description" content={t.description} />
      <meta property="og:url" content={shareUrl.href} />
      <meta property="og:locale" content={shareLocales[locale]} />
      <meta property="og:locale:alternate" content={shareLocales[alternate]} />
      <meta property="og:image" content={shareImage.href} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={t.shareImageAlt} />
    </>}
    <script is:inline>
      try {
        const selected = localStorage.getItem('originlink-theme');
        document.documentElement.dataset.theme = selected === 'dark' || selected === 'light' ? selected : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
  <body id="inicio">
    <a href="#principal" class="skip" data-i18n="skip">{t.skip}</a>
    <header class="mast wrap">
      <a href="#inicio" class="brand" aria-label={t.home} data-i18n-label="home"><img src={assetRoot + "/marca/01-horizontal.svg"} width="1355" height="332" alt="" /></a>
      <nav class="desktop-nav" aria-label={t.nav} data-i18n-label="nav">{links.map(link => <a href={link.href} data-i18n={link.label}>{t[link.label]}</a>)}</nav>
      <div class="actions">
        <a class="language-control" href={alternateUrl} data-es-url={localeUrls.es} data-en-url={localeUrls.en} lang={languageTags[alternate]} hreflang={languageTags[alternate]} aria-label={alternate === 'en' ? 'English' : 'Español'}>{alternate.toUpperCase()}</a>
        <button class="theme-control" aria-label={t.dark} type="button"><span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span></button>
        <details class="mobile-nav"><summary aria-label={t.menu} data-i18n-label="menu"><Icon name="menu" /></summary><nav aria-label={t.mobileNav} data-i18n-label="mobileNav">{links.map(link => <a href={link.href} data-i18n={link.label}>{t[link.label]}</a>)}</nav></details>
      </div>
      <div class="account-actions">
        <a href={appUrl} class="button account-secondary" data-i18n="signIn">{t.signIn}</a>
        <a href={appUrl} class="button" data-i18n="signUp">{t.signUp}</a>
      </div>
    </header>
    <main id="principal">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <span class="overline hero-label"><i></i><span data-i18n="heroLabel">{t.heroLabel}</span></span>
          <h1 id="hero-title"><span data-i18n="heroTitle">{t.heroTitle}</span><br /><em data-i18n="heroEm">{t.heroEm}</em></h1>
          <p data-i18n="heroBody">{t.heroBody}</p>
          <div class="hero-links"><a class="button cream" href="#piloto"><span data-i18n="pilotCTA">{t.pilotCTA}</span> <Icon name="arrow" /></a><a class="text-link" href="#ejemplo"><span data-i18n="exampleLink">{t.exampleLink}</span> <Icon name="down" /></a></div>
        </div>
        <figure class="hero-photo" data-i18n-image="heroAlt">
          <Picture src={weighing} formats={['webp']} fallbackFormat="jpeg" widths={[480, 768, 1080, 1280]} sizes="(max-width: 760px) 100vw, 49vw" loading="eager" fetchpriority="high" alt={t.heroAlt} />
        </figure>
      </section>
      <section id="ejemplo" class="example section wrap" aria-labelledby="example-title">
        <div class="intro">
          <span class="overline"><i></i><span data-i18n="exampleLabel">{t.exampleLabel}</span></span>
          <h2 id="example-title"><span data-i18n="exampleTitle">{t.exampleTitle}</span><br /><em data-i18n="exampleEm">{t.exampleEm}</em></h2>
          <p data-i18n="exampleBody">{t.exampleBody}</p>
        </div>
        <div class="forecast-card">
          <div class="card-head"><span class="card-title"><Icon name="forecast" /> <span data-i18n="nextOrder">{t.nextOrder}</span></span><span class="sample-tag" data-i18n="demo">{t.demo}</span></div>
          <fieldset class="horizon">
            <legend data-i18n="period">{t.period}</legend>
            <div class="segments">
              <label><input type="radio" name="weeks" value="2" /><span data-i18n="twoWeeks">{t.twoWeeks}</span></label>
              <label><input type="radio" name="weeks" value="4" checked /><span data-i18n="fourWeeks">{t.fourWeeks}</span></label>
            </div>
          </fieldset>
          <div class="quantity" aria-live="polite" aria-atomic="true"><strong id="quantity">120</strong> kg <span data-i18n="replenish">{t.replenish}</span></div>
          <div class="bar" aria-hidden="true"><i></i></div>
          <dl class="figures"><div><dt data-i18n="stock">{t.stock}</dt><dd>36 kg</dd></div><div><dt data-i18n="demand">{t.demand}</dt><dd id="consumption">156 kg</dd></div><div><dt data-i18n="lead">{t.lead}</dt><dd data-i18n="days">{t.days}</dd></div></dl>
          <p class="card-note"><Icon name="check" /> <span data-i18n="note">{t.note}</span></p>
        </div>
      </section>
      <section class="process" id="proceso" aria-labelledby="process-title"><div class="wrap">
        <span class="overline"><i></i><span data-i18n="processLabel">{t.processLabel}</span></span><h2 id="process-title"><span data-i18n="processTitle">{t.processTitle}</span> <em data-i18n="processEm">{t.processEm}</em></h2>
        <ol class="steps">{steps.map((step, index) => <li><div class="step-top"><Icon name={step.icon} /><span><span data-i18n="step">{t.step}</span> 0{index + 1}</span></div><h3 data-i18n={step.title}>{t[step.title]}</h3><p data-i18n={step.body}>{t[step.body]}</p></li>)}</ol>
      </div></section>
      <section class="suppliers section wrap" id="proveedores" aria-labelledby="suppliers-title">
        <figure class="sample-photo" data-i18n-image="supplierAlt"><Picture src={sample} formats={['webp']} fallbackFormat="jpeg" widths={[480, 768, 1080]} sizes="(max-width: 760px) 100vw, 48vw" loading="lazy" alt={t.supplierAlt} /></figure>
        <div class="intro"><span class="overline"><i></i><span data-i18n="supplierLabel">{t.supplierLabel}</span></span><h2 id="suppliers-title"><span data-i18n="supplierTitle">{t.supplierTitle}</span><br /><em data-i18n="supplierEm">{t.supplierEm}</em></h2><p data-i18n="supplierBody">{t.supplierBody}</p><a class="inline-link" href="#piloto"><span data-i18n="join">{t.join}</span> <Icon name="arrow" /></a></div>
      </section>
      <section id="piloto" class="pilot shell" aria-labelledby="pilot-title"><div class="pilot-intro">
        <img width="55" height="55" src={assetRoot + "/marca/07-monocromo-blanco.svg"} alt="" loading="lazy" />
        <span class="overline" data-i18n="pilotLabel">{t.pilotLabel}</span><h2 id="pilot-title"><span data-i18n="pilotTitle">{t.pilotTitle}</span><br /><em data-i18n="pilotEm">{t.pilotEm}</em></h2><p data-i18n="pilotBody">{t.pilotBody}</p>
      </div>
      <form action={pilotEndpoint} method="post" id="pilot-form">
        {!externalEndpoint && <input type="hidden" name="locale" value={locale} />}
        <label for="contact" data-i18n="contact">{t.contact}</label><input id="contact" name="contacto" autocomplete="name" maxlength="100" required />
        <label for="roaster" data-i18n="roastery">{t.roastery}</label><input id="roaster" name="tostadora" autocomplete="organization" maxlength="150" required />
        <label for="email" data-i18n="email">{t.email}</label><input id="email" type="email" name="correo" autocomplete="email" maxlength="254" required />
        <button class="button cream" type="submit"><span data-i18n="pilotCTA">{t.pilotCTA}</span> <Icon name="arrow" /></button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form></section>
    </main>
    <footer class="wrap"><a href="#inicio" class="footer-brand"><img src={assetRoot + "/marca/05-monocromo.svg"} width="29" height="29" alt="" />OriginLink</a><span><Icon name="pin" /> <span data-i18n="location">{t.location}</span></span><a class="to-top" href="#inicio"><span data-i18n="top">{t.top}</span> <Icon name="up" /></a></footer>
    <script src="../landing.ts"></script>
  </body>
</html>
